# Neo Community Edition — copy to .env and fill in.
# The app (Next.js) auto-loads .env. docker compose reads the .env next to it too.

# ============================================================================
# 1) DATABASE — any Postgres (local, Docker, AWS RDS, Neon, Supabase, …)
# ============================================================================
DATABASE_URL=postgres://neo:neo@localhost:5432/neo

# ============================================================================
# 2) AUTH — builtin (default, no external service) | clerk
# ============================================================================
AUTH_PROVIDER=builtin
SKY_SESSION_SECRET=            # required for builtin. Generate: openssl rand -base64 32

# Optional: enterprise SSO on built-in auth (your own OIDC provider)
# NEO_CE_OIDC_ISSUER=
# NEO_CE_OIDC_CLIENT_ID=
# NEO_CE_OIDC_CLIENT_SECRET=

# Only if AUTH_PROVIDER=clerk:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# ============================================================================
# 3) MODEL PROVIDER — pick ONE. Bring your own; usage bills to you.
#    OPTIONAL here: you can also paste your Anthropic key on the first-run setup
#    screen (stored encrypted per org). Set it below only for automated deploys or
#    if you'd rather configure it up front.
# ============================================================================
# --- Option A: Anthropic API (simplest) ---
#     Get a key: https://console.anthropic.com  →  Settings → API Keys
# ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Option B: Amazon Bedrock (no API key; uses your AWS credentials) ---
#     Prereqs: (1) In the AWS console → Bedrock → Model access, request/enable
#     the Anthropic Claude models in your region. (2) Give the app AWS creds with
#     "bedrock:InvokeModel" — on AWS this is automatic via the EC2 instance role /
#     ECS task role; off AWS set AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
# MODEL_PROVIDER=bedrock
# AWS_REGION=us-east-1
#     Bedrock model ids differ from the API ids — set the exact inference-profile
#     ids available in your region (Bedrock console → Model catalog):
# BEDROCK_MODEL_DEEP=us.anthropic.claude-opus-4-...-v1:0
# BEDROCK_MODEL_FAST=us.anthropic.claude-sonnet-4-...-v1:0
# BEDROCK_MODEL_SCAFFOLD=us.anthropic.claude-haiku-4-...-v1:0

# ============================================================================
# 4) EDITION + BACKGROUND JOBS
# ============================================================================
NEO_EDITION=community

# The assessment engine runs as background jobs via Inngest. In docker compose a
# bundled Inngest dev server handles this automatically (INNGEST_DEV points at it).
# Running the app outside compose? Start one: `npx inngest-cli dev` and set:
# INNGEST_DEV=http://localhost:8288

# Optional tuning:
# CONTROLS_CONCURRENCY=2        # pillar-group calls to run at once (1 = sequential;
                               # lower this if your model key is rate-limited)
